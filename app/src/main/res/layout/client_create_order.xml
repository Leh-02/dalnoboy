<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".client.MainActivity">

    <include
        android:id="@+id/topBar"
        layout="@layout/client_upper_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Дані отримувача"
                android:fontFamily="@font/roboto_bold"
                android:textSize="24sp"
                android:textColor="#000000"

                android:layout_marginTop="52dp"
                android:layout_marginLeft="29dp"
                android:layout_marginBottom="11dp"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/text_border"

                android:layout_marginLeft="37dp"
                android:layout_marginRight="41dp"

                android:paddingTop="21dp"
                android:paddingBottom="21dp"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"

                >

                <EditText
                    android:id="@+id/phone_input"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentRight="true"


                    android:hint="Введіть номер телефону"
                    android:inputType="phone"
                    android:background="@drawable/input_form_border"

                    android:paddingLeft="11dp"/>

                <EditText
                    android:id="@+id/last_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="11dp"
                    android:hint="Прізвище"
                    android:inputType="textPersonName"
                    android:background="@drawable/input_form_border"
                    android:paddingLeft="11dp" />

                <EditText
                    android:id="@+id/first_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="11dp"
                    android:hint="Ім'я"
                    android:inputType="textPersonName"
                    android:background="@drawable/input_form_border"
                    android:paddingLeft="11dp" />

            </LinearLayout>


            <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Деталі відправлення"
            android:fontFamily="@font/roboto_bold"
            android:textSize="24sp"
            android:textColor="#000000"

            android:layout_marginTop="28dp"
            android:layout_marginLeft="29dp"
            android:layout_marginBottom="11dp"
            />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="37dp"
                android:layout_marginRight="41dp"

                android:background="@drawable/text_border"
                android:orientation="vertical"

                android:paddingLeft="7dp"
                android:paddingTop="21dp"
                android:paddingRight="7dp"
                android:paddingBottom="21dp"

                >

                <EditText
                    android:id="@+id/devivery_name"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentRight="true"


                    android:background="@drawable/input_form_border"
                    android:hint="Назва відправлення"
                    android:inputType="text"

                    android:paddingLeft="11dp" />

                <EditText
                    android:id="@+id/weight"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/input_form_border"
                    android:hint="Вага, кг"
                    android:inputType="number"
                    android:paddingLeft="11dp" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="13dp"
                    android:fontFamily="@font/roboto_bold"

                    android:text="Відправлення"
                    android:textColor="#000000"
                    android:textSize="16sp" />


                <include
                    android:id="@+id/city_spinner1"
                    layout="@layout/spinner_city" />

                <EditText
                    android:id="@+id/pick_up_street"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/input_form_border"
                    android:hint="Адреса відправлення"
                    android:inputType="text"
                    android:paddingLeft="11dp" />


                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="13dp"
                    android:fontFamily="@font/roboto_bold"

                    android:text="Отримання"
                    android:textColor="#000000"
                    android:textSize="16sp" />


                <include
                    android:id="@+id/city_spinner2"
                    layout="@layout/spinner_city" />

                <EditText
                    android:id="@+id/delivery_street"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/input_form_border"
                    android:hint="Адреса отримання"
                    android:inputType="text"
                    android:paddingLeft="11dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вартість доставки"
                android:fontFamily="@font/roboto_bold"
                android:textSize="24sp"
                android:textColor="#000000"

                android:layout_marginTop="28dp"
                android:layout_marginLeft="29dp"
                android:layout_marginBottom="11dp"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/text_border"

                android:layout_marginLeft="37dp"
                android:layout_marginRight="41dp"

                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"

                >

                <TextView
                    android:id="@+id/delivery_price"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="0 грн"
                    android:fontFamily="@font/roboto_bold"
                    android:textSize="24sp"
                    android:background="@drawable/input_form_border"
                    android:paddingLeft="15dp"
                    android:gravity="center_vertical|start"
                />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Скасувати"
                    android:fontFamily="@font/roboto_medium"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:padding="12dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/input_form_border" />

                <Button
                    android:id="@+id/btn_submit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Оформити замовлення"
                    android:fontFamily="@font/roboto_bold"
                    android:textSize="16dp"
                    android:background="@drawable/red_border_button"
                    android:textColor="@android:color/holo_red_dark"
                    android:enabled="false"
                    android:padding="12dp"/>
            </LinearLayout>


        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomBar"
        layout="@layout/client_low_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
