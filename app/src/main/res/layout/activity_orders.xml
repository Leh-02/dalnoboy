<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Шапка (полный код) -->
    <LinearLayout
        android:id="@+id/app_header"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#E0E0E0"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="Логотип приложения"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btn_notifications"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Уведомления"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/not" />

        <ImageButton
            android:id="@+id/btn_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Профиль"
            android:src="@drawable/prof" />
    </LinearLayout>

    <!-- Список заказов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/orders_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/app_header"
        android:layout_above="@id/app_footer"
        android:padding="16dp"
        android:clipToPadding="false"/>

    <!-- Нижнее меню (полный код) -->
    <LinearLayout
        android:id="@+id/app_footer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#E0E0E0"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true">

        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/home"
            android:scaleType="centerInside"
            android:padding="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Главная"/>

        <ImageButton
            android:id="@+id/btn_orders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/orders"
            android:scaleType="centerInside"
            android:padding="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Заказы"/>

        <ImageButton
            android:id="@+id/btn_history"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/history"
            android:scaleType="centerInside"
            android:padding="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="История"/>

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/settings"
            android:scaleType="centerInside"
            android:padding="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Настройки"/>
    </LinearLayout>
</RelativeLayout>