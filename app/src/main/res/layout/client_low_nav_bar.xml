<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:background="#E1E1E1">

    <ImageButton
        android:id="@+id/free_icon_h"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="37dp"
        android:layout_marginStart="30dp"
        android:background="@android:color/transparent"
        android:src="@drawable/free_icon_h"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/free_icon_c"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="37dp"
        android:layout_marginStart="130dp"
        android:background="@android:color/transparent"
        android:src="@drawable/free_icon_c"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/free_icon_his"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="37dp"
        android:layout_marginStart="232dp"
        android:background="@android:color/transparent"
        android:src="@drawable/free_icon_his"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/free_icon_s"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="37dp"
        android:layout_marginEnd="30dp"
        android:background="@android:color/transparent"
        android:src="@drawable/free_icon_set"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
