<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <!-- Закріплений логотип -->

    <!-- Scrollable контент -->

    <ImageView
        android:id="@+id/logo"
        android:layout_width="109dp"
        android:layout_height="105dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.052"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Реєстрація"

                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/roboto_bold"
                android:textSize="32sp"/>

            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"

                android:background="@drawable/registration_field"
                android:hint="Ім'я"
                android:inputType="text"

                android:layout_marginTop="13dp"
                android:layout_marginRight="137dp"
                android:paddingLeft="10dp"
                />

            <EditText
                android:id="@+id/surname"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"

                android:background="@drawable/registration_field"
                android:hint="Прізвище"
                android:inputType="text"

                android:layout_marginTop="22dp"
                android:layout_marginRight="137dp"
                android:paddingLeft="10dp"
                />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginLeft="36dp"
                android:layout_marginTop="20dp"

                android:fontFamily="@font/roboto_bold"

                android:text="Номер телефону"
                android:textColor="#000000"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/phone_number"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"

                android:background="@drawable/registration_field"
                android:hint="+3805012345678"
                android:inputType="phone"

                android:layout_marginTop="12dp"
                android:layout_marginRight="137dp"
                android:paddingLeft="10dp"
                />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginLeft="36dp"
                android:layout_marginTop="20dp"

                android:fontFamily="@font/roboto_bold"

                android:text="Email"
                android:textColor="#000000"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"

                android:background="@drawable/registration_field"
                android:hint="abc@gmail.com"
                android:inputType="textEmailAddress"

                android:layout_marginTop="12dp"
                android:layout_marginRight="137dp"
                android:paddingLeft="10dp"
                />
            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginLeft="36dp"
                android:layout_marginTop="20dp"

                android:fontFamily="@font/roboto_bold"

                android:text="Пароль"
                android:textColor="#000000"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"

                android:background="@drawable/registration_field"
                android:hint="Створіть пароль"
                android:inputType="textVisiblePassword"

                android:layout_marginTop="12dp"
                android:layout_marginRight="137dp"
                android:paddingLeft="10dp"
                />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginLeft="36dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"

                android:fontFamily="@font/roboto_bold"

                android:text="Роль"
                android:textColor="#000000"
                android:textSize="20sp" />

            <RadioGroup
                android:id="@+id/roleGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/role_customer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Замовник"
                    android:textSize="20sp"/>

                <RadioButton
                    android:id="@+id/role_driver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Водій"
                    android:textSize="20sp"/>

                <RadioButton
                    android:id="@+id/role_admin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Адміністратор"
                    android:textSize="20sp"/>
            </RadioGroup>

            <Button
                android:id="@+id/buttonRegister"
                android:layout_width="326dp"
                android:layout_height="50dp"
                android:layout_below="@id/passwordErrorText"

                android:layout_centerHorizontal="true"
                android:backgroundTint="#FF0000"
                android:text="Зареєструватися"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginLeft="30dp"
                />
            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF0000"
                android:visibility="gone"
                android:layout_marginTop="8dp"/>



        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
