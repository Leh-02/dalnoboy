<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".driver.SettingsActivity">

    <!-- Шапка (как в MainActivity) -->
    <LinearLayout
        android:id="@+id/app_header"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#E0E0E0"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="Логотип приложения"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btn_notifications"
            android:layout_width="68dp"
            android:layout_height="78dp"
            android:src="@drawable/not"
            android:scaleType="centerInside"
            android:padding="15dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Уведомления"/>

        <ImageButton
            android:id="@+id/btn_profile"
            android:layout_width="68dp"
            android:layout_height="78dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/prof"
            android:scaleType="centerInside"
            android:padding="15dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Профиль пользователя"/>
    </LinearLayout>

    <!-- Основной контент с прокруткой -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/app_header"
        android:layout_above="@id/app_footer"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Заголовок -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Налаштування"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Разделитель -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000"
                android:layout_marginBottom="24dp"/>

            <!-- Пункт "Мова" с увеличенной touch target -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="#C5C5C5"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:minHeight="48dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Мова"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:paddingStart="16dp">

                    <Spinner
                        android:id="@+id/language_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:entries="@array/languages"
                        android:gravity="end"
                        android:background="@android:drawable/btn_dropdown"
                        android:spinnerMode="dropdown"/>
                </RelativeLayout>
            </LinearLayout>

            <!-- Пункт "Звукові повідомлення" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="#C5C5C5"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Звукові повідомлення"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:paddingStart="16dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/sound_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="64dp"
                        android:minHeight="48dp"
                        android:thumbTextPadding="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Пункт "Темна тема" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="#C5C5C5"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Темна тема"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:paddingStart="16dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/theme_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="64dp"
                        android:minHeight="48dp"
                        android:thumbTextPadding="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Нижнее меню (как в MainActivity) -->
    <LinearLayout
        android:id="@+id/app_footer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#E0E0E0"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true">

        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/home"
            android:scaleType="centerInside"
            android:padding="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Главная страница"/>

        <ImageButton
            android:id="@+id/btn_orders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/orders"
            android:scaleType="centerInside"
            android:padding="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Заказы"/>

        <ImageButton
            android:id="@+id/btn_history"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/history"
            android:scaleType="centerInside"
            android:padding="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="История"/>

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/settings"
            android:scaleType="centerInside"
            android:padding="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Настройки"/>
    </LinearLayout>
</RelativeLayout>