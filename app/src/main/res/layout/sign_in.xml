<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sign_in_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Логотип -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="187.5dp"
        android:layout_height="187.5dp"
        android:layout_marginTop="29dp"
        android:layout_centerHorizontal="true"
        android:src="@mipmap/ic_launcher"
    android:contentDescription="Логотип" />

    <EditText
        android:id="@+id/editTextLogin"
        android:layout_width="340dp"
        android:layout_height="60dp"
        android:layout_below="@id/logo"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true"
        android:hint="Логін"
        android:background="@drawable/input_form_border"
        android:paddingStart="16dp"
        android:textSize="16sp" />

    <!-- Помилка логіна -->
    <TextView
        android:id="@+id/loginErrorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextLogin"
        android:layout_marginStart="50dp"
        android:layout_marginTop="4dp"
        android:textColor="#FF0000"
        android:textSize="14sp"
        android:visibility="gone"
        android:text="Користувача не знайдено\nЗареєструйтесь у системі" />

    <!-- Поле Пароль -->
    <EditText
        android:id="@+id/editTextPassword"
        android:layout_width="340dp"
        android:layout_height="60dp"
        android:layout_below="@id/loginErrorText"
        android:layout_marginTop="10dp"
        android:layout_centerHorizontal="true"
        android:hint="Пароль"
        android:background="@drawable/input_form_border"
        android:elevation="2dp"
        android:paddingStart="16dp"
        android:textSize="16sp"
        android:inputType="textPassword" />

<!--    &lt;!&ndash; Іконка видимості пароля &ndash;&gt;-->
<!--    <ImageView-->
<!--        android:id="@+id/passwordToggle"-->
<!--        android:layout_width="32dp"-->
<!--        android:layout_height="32dp"-->
<!--        android:layout_alignTop="@id/editTextPassword"-->
<!--        android:layout_alignEnd="@id/editTextPassword"-->
<!--        android:layout_marginTop="14dp"-->
<!--        android:layout_marginEnd="8dp"-->
<!--        android:src="@android:drawable/ic_menu_view"-->
<!--        android:contentDescription="Toggle password visibility" />-->

    <!-- Помилка пароля -->
    <TextView
        android:id="@+id/passwordErrorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextPassword"
        android:layout_marginStart="50dp"
        android:layout_marginTop="4dp"
        android:textColor="#FF0000"
        android:textSize="14sp"
        android:visibility="gone"
        android:text="Невірний пароль\nСпробуйте ще раз" />

    <!-- Кнопка Увійти -->
    <Button
        android:id="@+id/buttonSignIn"
        android:layout_width="326dp"
        android:layout_height="50dp"
        android:layout_below="@id/passwordErrorText"
        android:layout_marginTop="30dp"
        android:layout_centerHorizontal="true"
        android:backgroundTint="#FF0000"
        android:text="Увійти"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
         />

    <!-- Кнопка Зареєструватися -->
    <Button
        android:id="@+id/buttonRegister"
        android:layout_width="326dp"
        android:layout_height="48dp"
        android:layout_below="@id/buttonSignIn"
        android:layout_marginTop="24dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/border_red"
        android:text="Зареєструватися"
        android:textColor="#FF0000"
        android:textSize="18sp"
        android:fontFamily="@font/roboto_bold"
        />

</RelativeLayout>
